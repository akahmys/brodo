{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/claude_guard.py",
            "args": []
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|WebFetch|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/provenance_guard.py",
            "args": []
          }
        ]
      }
    ]
  }
}
